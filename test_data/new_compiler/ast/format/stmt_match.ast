                        LBRACK@1798..1799 "{"
                        RBRACK@1799..1800 "}"
                WHITESPACE@1800..1810 "\n\n        "
                MATCH_ARM@1810..1817
                    LITERAL@1810..1811
                        NUMBER@1810..1811 "2"
                    WHITESPACE@1811..1812 " "
                    RARROW@1812..1814 "->"
                    WHITESPACE@1814..1815 " "
                    BLOCK_STMT@1815..1817
                        LBRACK@1815..1816 "{"
                        RBRACK@1816..1817 "}"
                WHITESPACE@1817..1822 "\n    "
                RBRACK@1822..1823 "}"
            WHITESPACE@1823..1824 "\n"
            RBRACK@1824..1825 "}"
    WHITESPACE@1825..1826 "\n"
